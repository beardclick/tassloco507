# ---- Supabase (base de datos + storage) ----
# En Supabase → Project Settings → API: copia la URL y la "service_role" key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Claves públicas (para el navegador, p. ej. recuperar contraseña).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx  # la "publishable" key

# ---- Resend (correos transaccionales) ----
# https://resend.com — crea una API key y verifica tu dominio.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente verificado en Resend (usa tu dominio, ej. pedidos@tassloco507.com)
EMAIL_FROM="Tass Loco 507 <pedidos@tassloco507.com>"
# Correo que recibe el aviso de nuevos pedidos
ADMIN_EMAIL=tassloco507@gmail.com

# ---- Admin ----
ADMIN_USER=admin
ADMIN_PASSWORD=una-contrasena-segura
ADMIN_SECRET=una-frase-secreta-larga-y-aleatoria

# ---- Autenticación de clientes ----
AUTH_SECRET=otra-frase-secreta-aleatoria
