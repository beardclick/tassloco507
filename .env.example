# ---- Supabase (base de datos + storage) ----
# En Supabase → Project Settings → API: copia la URL y la "service_role" key.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Claves públicas (para el navegador, p. ej. recuperar contraseña).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx  # la "publishable" key

# ---- Resend (correos transaccionales) ----
# https://resend.com — crea una API key y verifica tu dominio.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remitente verificado en Resend (usa tu dominio, ej. pedidos@tassloco507.com)
EMAIL_FROM="Tass Loco 507 <pedidos@tassloco507.com>"
# Correo que recibe el aviso de nuevos pedidos
ADMIN_EMAIL=tassloco507@gmail.com

# ---- Admin ----
# Obligatorio: genera un valor aleatorio distinto para cada secreto (>=32 caracteres).
# Ej.: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ADMIN_SECRET=
# Acceso por variables opcional; sin ambos valores queda deshabilitado.
# La contraseña debe tener al menos 12 caracteres. Preferir tabla admins o Auth con rol.
ADMIN_USER=
ADMIN_PASSWORD=
# Usuarios Auth autorizados explícitamente (alternativa a app_metadata.role = admin).
# No usar user_metadata para conceder permisos.
SUPABASE_ADMIN_EMAILS=

# ---- Autenticación de clientes ----
AUTH_SECRET=

# Origen público exacto; opcional si la URL de la petición ya es el origen público.
# APP_ORIGIN=https://tassloco507.com
# Solo para otro hosting con un proxy que sanee x-forwarded-for. Vercel se detecta solo.
# TRUST_PROXY=1
